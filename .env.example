DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
PORT=3000

# 知乎 OAuth（真实接入时填写；留空则进入明确的演示模式）
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=http://localhost:3000/auth/zhihu/callback
ZHIHU_OAUTH_AUTHORIZE_URL=https://openapi.zhihu.com/authorize
ZHIHU_OAUTH_TOKEN_URL=https://openapi.zhihu.com/access_token
ZHIHU_ACCESS_SECRET=

# A2A（Render 上建议配置；同一个 Web Service 内也会通过真实 HTTP 回环通信）
# Render Postgres 的 Internal Database URL
DATABASE_URL=
DATABASE_SSL=true
# 对外 Agent Card 使用的 URL；Render 可填 https://<service>.onrender.com
A2A_PUBLIC_URL=
# 多服务/公网调用时必填；单服务本地开发可留空
A2A_SHARED_SECRET=
# A2A HTTP 调用地址；留空时使用本机回环地址，最适合单个 Render Web Service
A2A_BASE_URL=
